{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cadreview/diff",
  "title": "Per-part geometry diff of model b (current) against model a (baseline), with detector warnings",
  "type": "object",
  "required": ["schema", "created", "a", "b", "tolerances", "summary", "parts", "collateral"],
  "additionalProperties": false,
  "$defs": {
    "side": {"type": "object", "required": ["label", "files"], "additionalProperties": false,
      "properties": {"label": {"type": "string"}, "id": {"type": ["string", "null"]},
                     "build": {"type": ["string", "null"]},
                     "kind": {"enum": ["reviewed", "build", "version", "file"],
                              "description": "the build the last packet was sent against, an earlier build, a manifest version or a loose file"},
                     "packet": {"type": ["string", "null"], "description": "kind reviewed: the packet id"},
                     "files": {"type": "array", "items": {"type": "string"}}}},
    "stats": {"type": "object", "required": ["tris", "bbox", "volume", "area", "centroid", "hash"],
      "properties": {"tris": {"type": "integer"}, "bbox": {"$ref": "common.schema.json#/$defs/bbox"},
        "volume": {"type": "number"}, "area": {"type": "number"}, "centroid": {"$ref": "common.schema.json#/$defs/vec3"},
        "moments": {"type": "array", "items": {"type": "number"}}, "hash": {"type": "string"},
        "shape_hash": {"type": "string"}}},
    "warning": {"type": "object", "required": ["kind", "part", "message"], "additionalProperties": false,
      "properties": {"kind": {"enum": ["new_components", "slivers", "thin_feature", "triangle_jump", "floating"]},
        "part": {"type": "string"}, "message": {"type": "string"}, "value": {"type": ["number", "null"]},
        "baseline": {"type": ["number", "null"]}, "at": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/vec3"}]}}}
  },
  "properties": {
    "schema": {"const": "cadreview/1"},
    "created": {"type": "string"},
    "seconds": {"type": "number"},
    "a": {"$ref": "#/$defs/side"},
    "b": {"$ref": "#/$defs/side"},
    "tolerances": {"type": "object", "required": ["position_mm", "relative"],
      "properties": {"position_mm": {"type": "number"}, "relative": {"type": "number"},
                     "thin_mm": {"type": "number"}, "contact_mm": {"type": "number"}}},
    "scope": {"type": ["array", "null"], "items": {"type": "string"},
              "description": "node names that were allowed to change; null means no scope lock was set"},
    "summary": {"type": "object", "required": ["unchanged", "moved", "changed", "added", "removed"],
      "properties": {"unchanged": {"type": "integer"}, "moved": {"type": "integer"}, "changed": {"type": "integer"},
                     "added": {"type": "integer"}, "removed": {"type": "integer"}, "collateral": {"type": "integer"},
                     "warnings": {"type": "integer"}}},
    "collateral": {"type": "array", "items": {"type": "string"},
                   "description": "parts that changed, moved, appeared or vanished outside the scope lock"},
    "parts": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "status": {"enum": ["unchanged", "moved", "changed", "added", "removed"]},
        "file": {"type": ["string", "null"]},
        "in_scope": {"type": ["boolean", "null"]},
        "collateral": {"type": "boolean"},
        "a": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stats"}]},
        "b": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stats"}]},
        "delta": {"type": ["object", "null"]},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
      }}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "skipped": {"type": "array", "items": {"type": "string"}}
  }
}
