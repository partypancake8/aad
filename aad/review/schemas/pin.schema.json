{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cadreview/pin",
  "title": "One review pin: a numbered marker on a part (point), on a feature edge of a part (edge) or a set of parts (region)",
  "type": "object",
  "required": ["schema", "id", "n", "kind", "status", "note", "issue_class", "severity", "created"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "cadreview/1"},
    "id": {"type": "string", "pattern": "^p[0-9]+$"},
    "n": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["point", "region", "edge"]},
    "status": {"enum": ["open", "resolved", "reopened", "not_fixed"]},
    "attempts": {"type": "integer", "minimum": 0, "description": "times the reviewer marked this pin Not fixed (an attempt that did not fix it)"},
    "escalated_build": {"type": ["string", "null"], "description": "the build it was last marked Not fixed on"},
    "escalated_at": {"$ref": "common.schema.json#/$defs/time"},
    "parent": {"type": ["string", "null"], "pattern": "^p[0-9]+$", "description": "follow-up pin: the id of the pin it follows up"},
    "escalation": {"type": "string", "description": "not_fixed pins in packets and aad review: the instruction to the next attempt"},
    "note": {"type": "string"},
    "reason": {"type": "string"},
    "class_meaning": {"type": "string"},
    "issue_class": {"$ref": "common.schema.json#/$defs/issue_class"},
    "severity": {"enum": ["low", "medium", "high"]},
    "anchor": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["part", "local", "normal_local", "world"],
      "additionalProperties": false,
      "properties": {
        "part": {"$ref": "common.schema.json#/$defs/part_ref"},
        "local": {"$ref": "common.schema.json#/$defs/vec3"},
        "normal_local": {"$ref": "common.schema.json#/$defs/vec3"},
        "world": {"$ref": "common.schema.json#/$defs/vec3"},
        "normal_world": {"$ref": "common.schema.json#/$defs/vec3"},
        "bbox": {"$ref": "common.schema.json#/$defs/bbox"}
      }}]},
    "edge": {"type": "object", "required": ["points", "length_mm", "start", "end", "midpoint", "direction"],
      "additionalProperties": false,
      "description": "kind edge: the picked feature-edge chain in part-local mm (mesh level; the anchor is the clicked point on it)",
      "properties": {
        "points": {"type": "array", "minItems": 2, "items": {"$ref": "common.schema.json#/$defs/vec3"}},
        "length_mm": {"type": "number", "minimum": 0},
        "start": {"$ref": "common.schema.json#/$defs/vec3"},
        "end": {"$ref": "common.schema.json#/$defs/vec3"},
        "midpoint": {"$ref": "common.schema.json#/$defs/vec3"},
        "direction": {"$ref": "common.schema.json#/$defs/vec3"}
      }},
    "parts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/part_ref"}},
    "rect": {"type": ["array", "null"], "items": {"type": "number"}},
    "measure": {"anyOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/measure"}]},
    "camera": {"$ref": "common.schema.json#/$defs/camera"},
    "build": {"type": ["string", "null"]},
    "source": {"enum": ["viewer", "tour", "cli"]},
    "tour_stop": {"type": ["string", "null"]},
    "created": {"type": "string"},
    "updated": {"$ref": "common.schema.json#/$defs/time"},
    "resolved_at": {"$ref": "common.schema.json#/$defs/time"},
    "resolved_build": {"type": ["string", "null"]},
    "reopened_at": {"$ref": "common.schema.json#/$defs/time"},
    "reopened_reason": {"type": ["string", "null"]}
  }
}
